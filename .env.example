# MongoDB connection string (local instance)
MONGODB_URI=mongodb://127.0.0.1:27017/marketlink

# JWT secret used to sign auth tokens - change this to a long random string
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Optional: AI assistant (OpenAI-compatible). Leave blank to use the
# database/FAQ fallback assistant instead.
AI_API_KEY=

# URL of the running frontend (used for CORS)
CLIENT_URL=http://localhost:5173

# Port the API server listens on
PORT=5000

# Node environment
NODE_ENV=development
